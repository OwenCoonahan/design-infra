{
  "$comment": "GENERATED from catalog/toolchain.json by scripts/build-toolchain.ts. The bootstrap (public/bootstrap.mjs) merges the registries of the tools it applies; this file is the full set for manual setup. Origin UI installs by URL (https://coss.com/origin/r/comp-N.json); shadcn blocks need no registry.",
  "registries": {
    "@design-infra": "https://www.owencoonahan.xyz/design-infra/r/{name}.json",
    "@magicui": "https://magicui.design/r/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@motion-primitives": "https://motion-primitives.com/c/{name}.json",
    "@aceternity": "https://ui.aceternity.com/registry/{name}.json",
    "@kibo-ui": "https://www.kibo-ui.com/r/{name}.json",
    "@cult-ui": "https://www.cult-ui.com/r/{name}.json",
    "@react-bits": "https://reactbits.dev/r/{name}.json",
    "@beautifui": "https://www.beautifului.dev/r/{name}.json",
    "@21st": {
      "url": "https://21st.dev/r/{name}",
      "params": {
        "api_key": "${API_KEY_21ST}"
      }
    },
    "@oc": "https://www.owencoonahan.xyz/design-infra/r/{name}.json"
  }
}
